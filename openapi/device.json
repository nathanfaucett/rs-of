{
  "components": {
    "schemas": {
      "ApprovedDeviceEndpoints": {
        "additionalProperties": false,
        "properties": {
          "endpointIds": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "endpointIds"
        ],
        "type": "object"
      },
      "Challenge": {
        "additionalProperties": false,
        "properties": {
          "challenge": {
            "type": "string"
          },
          "operation": {
            "$ref": "#/components/schemas/IndependentCreateIntent"
          },
          "recipient": {
            "type": "string"
          },
          "registration": {}
        },
        "required": [
          "operation",
          "recipient",
          "registration",
          "challenge"
        ],
        "type": "object"
      },
      "Device": {
        "properties": {
          "address": {
            "type": "string"
          },
          "publicKey": {
            "type": "string"
          }
        },
        "required": [
          "publicKey",
          "address"
        ],
        "type": "object"
      },
      "DeviceEndpointIdentity": {
        "properties": {
          "deviceId": {
            "type": "string"
          },
          "endpointId": {
            "type": "string"
          },
          "ownerSubject": {
            "type": "string"
          }
        },
        "required": [
          "deviceId",
          "ownerSubject",
          "endpointId"
        ],
        "type": "object"
      },
      "DeviceEnrollment": {
        "properties": {
          "approvalCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/DeviceState"
          }
        },
        "required": [
          "id",
          "state"
        ],
        "type": "object"
      },
      "DeviceEnrollmentRequest": {
        "properties": {
          "address": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "publicKey": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "publicKey",
          "address"
        ],
        "type": "object"
      },
      "DeviceInfo": {
        "properties": {
          "address": {
            "type": "string"
          },
          "createdAt": {
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "publicKey": {
            "type": "string"
          },
          "revokedAt": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "state": {
            "$ref": "#/components/schemas/DeviceState"
          },
          "updatedAt": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "publicKey",
          "address",
          "state",
          "createdAt",
          "updatedAt"
        ],
        "type": "object"
      },
      "DevicePairingApprovalPayload": {
        "properties": {
          "payload": {
            "type": "string"
          }
        },
        "required": [
          "payload"
        ],
        "type": "object"
      },
      "DevicePairingApprovalRequest": {
        "properties": {
          "signature": {
            "type": "string"
          }
        },
        "required": [
          "signature"
        ],
        "type": "object"
      },
      "DevicePairingRequest": {
        "properties": {
          "acceptingPublicKey": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "publicKey": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "publicKey",
          "address",
          "acceptingPublicKey"
        ],
        "type": "object"
      },
      "DeviceRestriction": {
        "additionalProperties": false,
        "properties": {
          "adminAllowed": {
            "type": "boolean"
          }
        },
        "required": [
          "adminAllowed"
        ],
        "type": "object"
      },
      "DeviceSelfRevocationRequest": {
        "properties": {
          "publicKey": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          }
        },
        "required": [
          "publicKey",
          "signature"
        ],
        "type": "object"
      },
      "DeviceState": {
        "enum": [
          "pending",
          "approved",
          "revoked"
        ],
        "type": "string"
      },
      "DeviceTransferRequest": {
        "additionalProperties": false,
        "properties": {
          "ownerSubject": {
            "type": "string"
          }
        },
        "required": [
          "ownerSubject"
        ],
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "database": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        },
        "required": [
          "database"
        ],
        "type": "object"
      },
      "HealthStatus": {
        "oneOf": [
          {
            "enum": [
              "healthy"
            ],
            "type": "string"
          },
          {
            "properties": {
              "unhealthy": {
                "type": "string"
              }
            },
            "required": [
              "unhealthy"
            ],
            "type": "object"
          }
        ]
      },
      "IndependentCreateIntent": {
        "additionalProperties": false,
        "properties": {
          "administrator": {
            "type": "string"
          },
          "device": {
            "type": "string"
          },
          "idp": {
            "type": "string"
          },
          "issuer": {
            "type": "string"
          },
          "node": {
            "type": "string"
          },
          "operation_nonce": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "storage": {
            "type": "string"
          }
        },
        "required": [
          "purpose",
          "operation_nonce",
          "administrator",
          "node",
          "idp",
          "device",
          "storage",
          "issuer"
        ],
        "type": "object"
      },
      "IndependentCreateRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/IndependentCreateIntent"
          },
          {
            "properties": {
              "password": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "type": "object"
          }
        ]
      },
      "IndependentOwnerPublic": {
        "additionalProperties": false,
        "properties": {
          "clients": {
            "items": {},
            "type": "array"
          },
          "facts": {},
          "operation": {
            "$ref": "#/components/schemas/IndependentCreateIntent"
          },
          "owner": {
            "type": "string"
          },
          "registered": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "operation",
          "owner",
          "clients",
          "facts",
          "registered"
        ],
        "type": "object"
      },
      "OwnerCopyCleanup": {
        "additionalProperties": false,
        "description": "Exact current Management binding; only an authenticated Storage service may acknowledge it.",
        "properties": {
          "cleanupId": {
            "type": "string"
          },
          "deviceId": {
            "type": "string"
          },
          "endpointId": {
            "type": "string"
          },
          "newOwnerSubject": {
            "type": "string"
          },
          "oldOwnerSubject": {
            "type": "string"
          }
        },
        "required": [
          "cleanupId",
          "deviceId",
          "endpointId",
          "oldOwnerSubject",
          "newOwnerSubject"
        ],
        "type": "object"
      },
      "OwnerSetupStatus": {
        "properties": {
          "owners": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "ready": {
            "type": "boolean"
          },
          "stage": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        },
        "required": [
          "stage",
          "state",
          "ready",
          "owners"
        ],
        "type": "object"
      },
      "Registration": {
        "additionalProperties": false,
        "properties": {
          "challenge": {
            "type": "string"
          },
          "operation": {
            "$ref": "#/components/schemas/IndependentCreateIntent"
          },
          "recipient": {
            "type": "string"
          },
          "registration": {}
        },
        "required": [
          "operation",
          "recipient",
          "registration",
          "challenge"
        ],
        "type": "object"
      },
      "ReplicationAdmissionRequest": {
        "additionalProperties": false,
        "properties": {
          "applicationId": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "resourceId": {
            "type": "string"
          },
          "sourceEndpointId": {
            "type": "string"
          },
          "targetEndpointId": {
            "type": "string"
          }
        },
        "required": [
          "sourceEndpointId",
          "targetEndpointId",
          "applicationId",
          "kind",
          "resourceId",
          "operation"
        ],
        "type": "object"
      },
      "SelectedResource": {
        "properties": {
          "applicationId": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "ownerSubject": {
            "type": "string"
          },
          "resourceId": {
            "type": "string"
          }
        },
        "required": [
          "ownerSubject",
          "applicationId",
          "kind",
          "resourceId"
        ],
        "type": "object"
      },
      "SelectedResourcesResponse": {
        "description": "Current policy for an IdP-approved endpoint with an active owner.\nPending cleanup is service-only evidence, never replication approval or cacheable permission.",
        "properties": {
          "adminAllowed": {
            "type": "boolean"
          },
          "deviceId": {
            "type": "string"
          },
          "endpointId": {
            "type": "string"
          },
          "ownerSubject": {
            "type": "string"
          },
          "pendingCleanup": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/OwnerCopyCleanup"
              }
            ]
          },
          "resources": {
            "items": {
              "$ref": "#/components/schemas/SelectedResource"
            },
            "type": "array"
          }
        },
        "required": [
          "deviceId",
          "endpointId",
          "ownerSubject",
          "adminAllowed",
          "resources"
        ],
        "type": "object"
      },
      "SelectionKind": {
        "enum": [
          "database",
          "filesystem"
        ],
        "type": "string"
      },
      "SelectionRequest": {
        "additionalProperties": false,
        "properties": {
          "applicationId": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/SelectionKind"
          },
          "storageAccessToken": {
            "type": "string"
          }
        },
        "required": [
          "applicationId",
          "kind",
          "id",
          "storageAccessToken"
        ],
        "type": "object"
      },
      "TrustedDevice": {
        "properties": {
          "address": {
            "type": "string"
          },
          "publicKey": {
            "type": "string"
          }
        },
        "required": [
          "publicKey",
          "address"
        ],
        "type": "object"
      },
      "UpdateDeviceRequest": {
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "VersionResponse": {
        "properties": {
          "build": {
            "format": "date-time",
            "type": "string"
          },
          "features": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "build"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "authorization": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "setup_code": {
        "description": "Setup <this owner's host-generated code>; never OAuth or another owner's code",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "contact": {
      "name": "nathanfaucett@gmail.com"
    },
    "description": "Device API server for LIDP",
    "license": {
      "identifier": "MIT OR Apache-2.0",
      "name": "MIT OR Apache-2.0"
    },
    "title": "LIDP Device API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/device": {
      "get": {
        "operationId": "device",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Device"
                }
              }
            },
            "description": "Local device identity"
          }
        }
      }
    },
    "/devices": {
      "get": {
        "operationId": "list_devices",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DeviceInfo"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Devices"
          }
        },
        "security": [
          {
            "authorization": []
          }
        ]
      }
    },
    "/devices/endpoints": {
      "get": {
        "operationId": "list_approved_device_endpoints",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovedDeviceEndpoints"
                }
              }
            },
            "description": "Approved endpoint IDs"
          },
          "401": {
            "description": "Invalid client access token"
          },
          "403": {
            "description": "Client lacks device-list permission"
          }
        },
        "security": [
          {
            "authorization": []
          }
        ]
      }
    },
    "/devices/endpoints/{endpoint_id}": {
      "get": {
        "operationId": "lookup_device_endpoint",
        "parameters": [
          {
            "description": "Iroh endpoint public key",
            "in": "path",
            "name": "endpoint_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceEndpointIdentity"
                }
              }
            },
            "description": "Approved endpoint identity"
          },
          "401": {
            "description": "Invalid client access token"
          },
          "403": {
            "description": "Client lacks device lookup permission"
          },
          "404": {
            "description": "Endpoint is not an approved device"
          }
        },
        "security": [
          {
            "authorization": []
          }
        ]
      }
    },
    "/devices/enrollments": {
      "get": {
        "operationId": "list_pending_enrollments",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DeviceEnrollment"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Pending device enrollments"
          }
        },
        "security": [
          {
            "authorization": []
          }
        ]
      },
      "post": {
        "operationId": "enroll_device",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceEnrollmentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceEnrollment"
                }
              }
            },
            "description": "Device enrollment"
          }
        },
        "security": [
          {
            "authorization": []
          }
        ]
      }
    },
    "/devices/enrollments/{device_id}/approve": {
      "post": {
        "operationId": "approve_enrollment",
        "parameters": [
          {
            "in": "path",
            "name": "device_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceEnrollment"
                }
              }
            },
            "description": "Approved enrollment"
          }
        },
        "security": [
          {
            "authorization": []
          }
        ]
      }
    },
    "/devices/identities/{device_id}": {
      "get": {
        "operationId": "lookup_device_identity",
        "parameters": [
          {
            "description": "Device ID",
            "in": "path",
            "name": "device_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceEndpointIdentity"
                }
              }
            },
            "description": "Locally trusted Device owner"
          }
        },
        "security": [
          {
            "authorization": []
          }
        ]
      }
    },
    "/devices/pairings": {
      "post": {
        "operationId": "request_pairing",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DevicePairingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceEnrollment"
                }
              }
            },
            "description": "Pending Device pairing"
          },
          "401": {
            "description": "User authentication required"
          },
          "403": {
            "description": "Enrollment not authorized"
          }
        },
        "security": [
          {
            "authorization": []
          }
        ]
      }
    },
    "/devices/pairings/{device_id}/approve": {
      "post": {
        "operationId": "approve_pairing",
        "parameters": [
          {
            "in": "path",
            "name": "device_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DevicePairingApprovalRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceInfo"
                }
              }
            },
            "description": "Approved Device after proof of its endpoint key"
          },
          "401": {
            "description": "User authentication required"
          },
          "403": {
            "description": "Proof or enrollment permission denied"
          }
        },
        "security": [
          {
            "authorization": []
          }
        ]
      }
    },
    "/devices/pairings/{device_id}/payload": {
      "get": {
        "operationId": "pairing_approval_payload",
        "parameters": [
          {
            "in": "path",
            "name": "device_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DevicePairingApprovalPayload"
                }
              }
            },
            "description": "Exact payload to sign with the new Device key"
          },
          "401": {
            "description": "User authentication required"
          },
          "403": {
            "description": "Pairing not authorized or no longer pending"
          }
        },
        "security": [
          {
            "authorization": []
          }
        ]
      }
    },
    "/devices/revoke-self": {
      "post": {
        "operationId": "revoke_self",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceSelfRevocationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Device revoked"
          }
        }
      }
    },
    "/devices/trusted": {
      "get": {
        "operationId": "trusted_devices",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TrustedDevice"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Approved devices"
          }
        },
        "security": [
          {
            "authorization": []
          }
        ]
      }
    },
    "/devices/{device_id}/owner": {
      "put": {
        "operationId": "transfer_device",
        "parameters": [
          {
            "in": "path",
            "name": "device_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceTransferRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Ownership updated; each Node must finish learned local cleanup before new-owner use"
          }
        },
        "security": [
          {
            "authorization": []
          }
        ]
      }
    },
    "/devices/{device_id}/restriction": {
      "get": {
        "operationId": "get_device_restriction",
        "parameters": [
          {
            "in": "path",
            "name": "device_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceRestriction"
                }
              }
            },
            "description": "Current Device restriction"
          }
        },
        "security": [
          {
            "authorization": []
          }
        ]
      },
      "put": {
        "operationId": "put_device_restriction",
        "parameters": [
          {
            "in": "path",
            "name": "device_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceRestriction"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Device restriction updated"
          }
        },
        "security": [
          {
            "authorization": []
          }
        ]
      }
    },
    "/devices/{device_id}/selection": {
      "put": {
        "operationId": "put_device_selection",
        "parameters": [
          {
            "description": "Device ID",
            "in": "path",
