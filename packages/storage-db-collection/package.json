    "format:fix": "biome format --write ."
  },
  "dependencies": {
    "@ofsdk/storage-client": "workspace:*",
    "@standard-schema/spec": "~1.1.0",
    "@tanstack/db": "~0.15.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "typescript": "^5.9.3",
    "valibot": "^1.4.2",
    "vitest": "4.1.10"
  }
}
