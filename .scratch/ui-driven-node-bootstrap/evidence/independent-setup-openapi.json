{
  "openapi": "3.1.0",
  "info": {
    "title": "Independent owner setup",
    "description": "OAuth 2.x API",
    "contact": {
      "name": "nathanfaucett@gmail.com"
    },
    "license": {
      "name": "MIT OR Apache-2.0",
      "identifier": "MIT OR Apache-2.0"
    },
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "https://owner.example"
    }
  ],
  "paths": {
    "/setup/admission": {
      "post": {
        "tags": [
          "default"
        ],
        "operationId": "admission",
        "responses": {
          "204": {
            "description": "This owner code is currently admitted"
          },
          "401": {
            "description": "Code invalid or retired"
          },
          "503": {
            "description": "Admission unavailable"
          }
        },
        "security": [
          {
            "setup_code": []
          }
        ]
      }
    },
    "/setup/cancel": {
      "post": {
        "tags": [
          "default"
        ],
        "operationId": "cancel",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IndependentCreateIntent"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Cancellation signaled; not cleanup completion"
          },
          "401": {
            "description": "Code invalid or retired"
          },
          "409": {
            "description": "No matching active operation"
          },
          "503": {
            "description": "Admission unavailable"
          }
        },
        "security": [
          {
            "setup_code": []
          }
        ]
      }
    },
    "/setup/create": {
      "post": {
        "tags": [
          "default"
        ],
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IndependentCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Exact Create accepted; empty body, not completion"
          },
          "400": {
            "description": "Invalid tuple or password"
          },
          "401": {
            "description": "Code invalid or retired"
          },
          "409": {
            "description": "Conflicting retained operation"
          },
          "503": {
            "description": "Owner unavailable"
          }
        },
        "security": [
          {
            "setup_code": []
          }
        ]
      }
    },
    "/setup/independent/public": {
      "get": {
        "tags": [
          "default"
        ],
        "operationId": "owner_public",
        "responses": {
          "200": {
            "description": "Operation-bound public owner metadata, not setup authorization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndependentOwnerPublic"
                }
              }
            }
          },
          "409": {
            "description": "Public owner metadata not yet available"
          }
        }
      }
    },
    "/setup/intent": {
      "post": {
        "tags": [
          "default"
        ],
        "operationId": "recover",
        "responses": {
          "200": {
            "description": "Exact retained nonsecret operation with authenticated issuer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndependentCreateIntent"
                }
              }
            }
          },
          "204": {
            "description": "No bound operation; empty body"
          },
          "401": {
            "description": "Code invalid or retired"
          },
          "503": {
            "description": "Admission unavailable"
          }
        },
        "security": [
          {
            "setup_code": []
          }
        ]
      }
    },
    "/setup/join": {
      "post": {
        "tags": [
          "default"
        ],
        "operationId": "join",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IndependentCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Exact Join accepted after authenticated discovery; empty body"
          },
          "400": {
            "description": "Invalid tuple; Join forbids password and administrator"
          },
          "401": {
            "description": "Code invalid or retired"
          },
          "409": {
            "description": "Conflicting retained operation"
          },
          "502": {
            "description": "Pinned peer discovery failed"
          },
          "503": {
            "description": "Owner unavailable"
          }
        },
        "security": [
          {
            "setup_code": []
          }
        ]
      }
    },
    "/setup/status": {
      "get": {
        "tags": [
          "default"
        ],
        "operationId": "status",
        "responses": {
          "200": {
            "description": "Owner-local state; no login Client or secret",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndependentSetupStatus"
                }
              }
            }
          },
          "503": {
            "description": "Admission unavailable; empty body"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "IndependentCreateIntent": {
        "type": "object",
        "required": [
          "purpose",
          "operation_nonce",
          "administrator",
          "node",
          "idp",
          "management",
          "storage",
          "issuer"
        ],
        "properties": {
          "administrator": {
            "type": "string"
          },
          "idp": {
            "type": "string"
          },
          "issuer": {
            "type": "string"
          },
          "management": {
            "type": "string"
          },
          "node": {
            "type": "string"
          },
          "operation_nonce": {
            "type": "string"
          },
          "peer": {
            "type": [
              "string",
              "null"
            ]
          },
          "purpose": {
            "type": "string"
          },
          "storage": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "IndependentCreateRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/IndependentCreateIntent"
          },
          {
            "type": "object",
            "properties": {
              "password": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        ]
      },
      "IndependentOwnerPublic": {
        "type": "object",
        "required": [
          "operation",
          "owner",
          "clients",
          "facts",
          "registered"
        ],
        "properties": {
          "clients": {
            "type": "array",
            "items": {}
          },
          "facts": {},
          "operation": {
            "$ref": "#/components/schemas/IndependentCreateIntent"
          },
          "owner": {
            "type": "string"
          },
          "registered": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "IndependentSetupStatus": {
        "type": "object",
        "required": [
          "stage",
          "state",
          "ready",
          "owners"
        ],
        "properties": {
          "owners": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ready": {
            "type": "boolean"
          },
          "stage": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "setup_code": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Setup <this owner's host-generated code>; never OAuth or another owner's code"
      }
    }
  }
}