{
    "extends": "./.svelte-kit/tsconfig.json",
    "compilerOptions": {
        "skipLibCheck": true,
        "rewriteRelativeImportExtensions": true,
        "paths": {
            "$lib": ["./src/lib"],
            "$lib/*": ["./src/lib/*"],
            "$app/types": ["./.svelte-kit/types/index.d.ts"],
            "$fixtures": ["./src/test/fixtures"],
            "$fixtures/*": ["./src/test/fixtures/*"]
        }
    }
}
