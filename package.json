{
  "name": "@local/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm -r run test",
    "coverage": "pnpm -r run coverage",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "format": "pnpm -r run format",
    "format:fix": "pnpm -r run format:fix",
    "apps:dev": "pnpm --filter \"./apps/*\" run dev",
    "apps:build": "pnpm --filter \"./apps/*\" run build",
    "apps:desktop": "pnpm --filter \"./apps/*\" run desktop",
    "packages:build": "pnpm --filter \"./packages/*\" --filter \"./crates/*\" run build",
    "openapi:idp": "pnpm --filter \"./packages/idp-client\" run openapi",
    "openapi:device": "node scripts/generate-openapi-client.mjs device",
    "openapi:management": "pnpm --filter \"./packages/management-client\" run openapi",
    "openapi": "node scripts/generate-openapi-client.mjs",
    "openapi:export": "cargo run -p unified-server --example export-openapi -- openapi",
    "openapi:check": "node scripts/qualify-openapi-clients.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "portless": "^0.15.4"
  }
}
