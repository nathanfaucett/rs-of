  { "name": "mismatched-type-payload", "patch": [{ "op": "add", "path": "/items/0/card", "value": {} }], "expect": "block", "path": "/items/0/card" },
  { "name": "repeat-import", "patch": [], "destination": "A prior import of supported.json with encrypted provenance", "expect": "confirm-import-as-new-or-cancel", "assertion": "Cancel leaves destination unchanged; confirm adds all five as fresh identities." },
  { "name": "logical-round-trip", "patch": [], "expect": "round-trip", "assertion": "Export/import in clean storage preserves all supported logical fields, ordered arrays, folder links and date instants through an ID map; missing dates use disclosed import time." },
