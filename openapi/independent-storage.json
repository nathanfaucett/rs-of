{
  "components": {
    "schemas": {
      "HistoryRequest": {
        "additionalProperties": false,
        "properties": {
          "approval": {
            "$ref": "#/components/schemas/IndependentJoinApproval"
          },
          "recipient": {
            "type": "string"
          },
          "return_nonce": {
            "type": "string"
          }
        },
        "required": [
          "approval",
          "recipient",
          "return_nonce"
        ],
        "type": "object"
      },
      "IndependentCreateIntent": {
        "additionalProperties": false,
        "properties": {
          "administrator": {
            "type": "string"
          },
          "idp": {
            "type": "string"
          },
          "issuer": {
            "type": "string"
          },
          "management": {
            "type": "string"
          },
          "node": {
            "type": "string"
          },
          "operation_nonce": {
            "type": "string"
          },
          "peer": {
            "type": [
              "string",
              "null"
            ]
          },
          "purpose": {
            "type": "string"
          },
          "storage": {
            "type": "string"
          }
        },
        "required": [
          "purpose",
          "operation_nonce",
          "administrator",
          "node",
          "idp",
          "management",
          "storage",
          "issuer"
        ],
        "type": "object"
      },
      "IndependentJoinApproval": {
        "additionalProperties": false,
        "properties": {
          "owner_subject": {
            "format": "uuid",
            "type": "string"
          },
          "request": {
            "$ref": "#/components/schemas/IndependentJoinRequest"
          },
          "signature": {
            "type": "string"
          }
        },
        "required": [
          "request",
          "owner_subject",
          "signature"
        ],
        "type": "object"
      },
      "IndependentJoinRequest": {
        "additionalProperties": false,
        "properties": {
          "device_id": {
            "format": "uuid",
            "type": "string"
          },
          "endpoint_id": {
            "type": "string"
          },
          "member_id": {
            "format": "uuid",
            "type": "string"
          },
          "operation": {
            "$ref": "#/components/schemas/IndependentCreateIntent"
          },
          "public_signer": {
            "$ref": "#/components/schemas/JwkPublic"
          },
          "source": {
            "$ref": "#/components/schemas/IndependentPeer"
          }
        },
        "required": [
          "operation",
          "device_id",
          "member_id",
          "endpoint_id",
          "public_signer",
          "source"
        ],
        "type": "object"
      },
      "IndependentPeer": {
        "additionalProperties": false,
        "properties": {
          "address": {},
          "endpoint": {
            "type": "string"
          },
          "idp": {
            "type": "string"
          },
          "issuer": {
            "type": "string"
          },
          "management": {
            "type": "string"
          },
          "nonce": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          }
        },
        "required": [
          "nonce",
          "issuer",
          "idp",
          "management",
          "endpoint",
          "address",
          "signature"
        ],
        "type": "object"
      },
      "JwkPublic": {
        "allOf": [
          {
            "$ref": "#/components/schemas/JwkPublicParameters"
          },
          {
            "properties": {
              "alg": {
                "$ref": "#/components/schemas/JwsAlgorithm",
                "description": "Algorithm intended for use"
              },
              "kid": {
                "description": "Key ID",
                "type": "string"
              },
              "use": {
                "$ref": "#/components/schemas/KeyUse",
                "description": "Key use (sig, enc)"
              }
            },
            "required": [
              "use",
              "kid",
              "alg"
            ],
            "type": "object"
          }
        ]
      },
      "JwkPublicParameters": {
        "oneOf": [
          {
            "properties": {
              "e": {
                "type": "string"
              },
              "kty": {
                "enum": [
                  "Rsa"
                ],
                "type": "string"
              },
              "n": {
                "type": "string"
              }
            },
            "required": [
              "n",
              "e",
              "kty"
            ],
            "type": "object"
          },
          {
            "properties": {
              "crv": {
                "type": "string"
              },
              "kty": {
                "enum": [
                  "Ec"
                ],
                "type": "string"
              },
              "x": {
                "type": "string"
              },
              "y": {
                "type": "string"
              }
            },
            "required": [
              "crv",
              "x",
              "y",
              "kty"
            ],
            "type": "object"
          },
          {
            "properties": {
              "crv": {
                "type": "string"
              },
              "kty": {
                "enum": [
                  "Opk"
                ],
                "type": "string"
              },
              "x": {
                "type": "string"
              }
            },
            "required": [
              "crv",
              "x",
              "kty"
            ],
            "type": "object"
          }
        ]
      },
      "JwsAlgorithm": {
        "enum": [
          "RS256",
          "RS384",
          "RS512",
          "ES256",
          "ES256K",
          "ES384",
          "ES512",
          "PS256",
          "PS384",
          "PS512",
          "EdDSA"
        ],
        "type": "string"
      },
      "KeyUse": {
        "enum": [
          "sig",
          "enc"
        ],
        "type": "string"
      }
    }
  },
  "info": {
    "contact": {
      "name": "nathanfaucett@gmail.com"
    },
    "description": "Management service implementation",
    "license": {
      "identifier": "MIT OR Apache-2.0",
      "name": "MIT OR Apache-2.0"
    },
    "title": "management-service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/node-joins/history/request": {
      "post": {
        "description": "Requires verified exact independent approval and current owner permission. Returns a capability only through the operation-bound recipient callback.",
        "operationId": "request_history",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HistoryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Callback accepted"
          },
          "400": {
            "description": "Invalid recipient"
          },
          "403": {
            "description": "Approval denied"
          },
          "503": {
            "description": "Unavailable"
          }
        },
        "security": [
          {}
        ],
        "tags": []
      }
    },
    "/node-joins/history/stream": {
      "get": {
        "description": "WebSocket upgrade only. The subsequent bounded binary SQL history protocol is not implemented by generated HTTP clients.",
        "operationId": "history_stream",
        "parameters": [
          {
            "description": "History <single-use operation-bound capability>",
            "in": "header",
            "name": "Authorization",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Upgrade",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Connection",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Sec-WebSocket-Key",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Sec-WebSocket-Version",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "101": {
            "description": "Switching to bounded history WebSocket protocol"
          },
          "400": {
            "description": "Invalid WebSocket handshake"
          },
          "401": {
            "description": "History capability required"
          },
          "403": {
            "description": "Capability expired or denied"
          }
        },
        "security": [
          {}
        ],
        "tags": []
      }
    }
  },
  "servers": [
    {
      "url": "https://localhost/"
    }
  ]
}
