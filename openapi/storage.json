    "/filesystems/{filesystem_id}/residency": {
      "get": {
        "operationId": "get_file_system_residency",
        "parameters": [
          {
            "description": "Filesystem resource ID",
            "in": "path",
            "name": "filesystem_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResourceResidency"
                }
              }
            },
            "description": "Current local whole-filesystem mode, not content availability"
          },
          "401": {
            "description": "Invalid Storage User authorization"
          },
          "403": {
            "description": "Token does not permit reads"
          },
          "404": {
            "description": "Filesystem not found in the authorized namespace"
          },
          "409": {
            "description": "Local copy unavailable; cleanup must not be bypassed"
          },
          "500": {
            "description": "Owner Residency read failed"
          },
          "503": {
            "description": "Local Storage or identity service unavailable"
          }
        },
        "security": [
          {
            "authorization": []
          }
        ],
        "tags": [
          "resources::residency"
        ]
      },
      "put": {
        "operationId": "put_file_system_residency",
        "parameters": [
          {
            "description": "Filesystem resource ID",
            "in": "path",
            "name": "filesystem_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResourceResidency"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Local whole-filesystem Residency persisted; not content availability or cleanup completion"
          },
          "401": {
            "description": "Invalid Storage User authorization"
          },
          "403": {
            "description": "Token does not permit writes"
          },
          "404": {
            "description": "Filesystem not found in the authorized namespace"
          },
          "409": {
            "description": "Local copy unavailable; cleanup must not be bypassed"
          },
          "500": {
            "description": "Owner Residency update failed; retry/read current mode"
          },
          "503": {
            "description": "Local Storage or identity service unavailable"
          }
        },
        "security": [
          {
            "authorization": []
          }
        ],
        "tags": [
          "resources::residency"
        ]
      }
    },
    "/health": {
