{
  "components": {
    "schemas": {
      "CancelRequest": {
        "additionalProperties": false,
        "properties": {
          "operation_nonce": {
            "type": "string"
          }
        },
        "required": ["operation_nonce"],
        "type": "object"
      },
      "Choice": {
        "enum": ["create", "join"],
        "type": "string"
      },
      "CreateRecovery": {
        "properties": {
          "administrator": {
            "type": "string"
          },
          "operation_nonce": {
            "type": "string"
          },
          "password_required": {
            "type": "boolean"
          }
        },
        "required": ["administrator", "password_required", "operation_nonce"],
        "type": "object"
      },
      "CreateRequest": {
        "additionalProperties": false,
        "properties": {
          "administrator": {
            "type": "string"
          },
          "password": {
            "type": ["string", "null"]
          }
        },
        "required": ["administrator"],
        "type": "object"
      },
      "Descriptor": {
        "oneOf": [
          {
            "properties": {
              "state": {
                "enum": ["awaiting_choice"],
                "type": "string"
              }
            },
            "required": ["state"],
            "type": "object"
          },
          {
            "properties": {
              "state": {
                "enum": ["starting"],
                "type": "string"
              }
            },
            "required": ["state"],
            "type": "object"
          },
          {
            "properties": {
              "state": {
                "enum": ["creating"],
                "type": "string"
              }
            },
            "required": ["state"],
            "type": "object"
          },
          {
            "properties": {
              "state": {
                "enum": ["joining"],
                "type": "string"
              }
            },
            "required": ["state"],
            "type": "object"
          },
          {
            "properties": {
              "state": {
                "enum": ["blocked"],
                "type": "string"
              }
            },
            "required": ["state"],
            "type": "object"
          },
          {
            "properties": {
              "idp": {
                "type": "string"
              },
              "login_client": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/LoginClient"
                  }
                ]
              },
              "state": {
                "enum": ["ready"],
                "type": "string"
              },
              "storage": {
                "type": "string"
              }
            },
            "required": ["idp", "storage", "state"],
            "type": "object"
          }
        ]
      },
      "LoginClient": {
        "properties": {
          "client_id": {
            "type": "string"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": ["client_id", "scopes"],
        "type": "object"
      }
    },
    "securitySchemes": {
      "node_setup_code": {
        "description": "Setup <protected Node code>",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "contact": {
      "name": "nathanfaucett@gmail.com"
    },
    "description": "Composition host for unified service deployment",
    "license": {
      "identifier": "MIT OR Apache-2.0",
      "name": "MIT OR Apache-2.0"
    },
    "title": "unified-server",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/setup/node": {
      "get": {
        "operationId": "node_setup_status",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Descriptor"
                }
              }
            },
            "description": "Current Node setup. Only verified completion publishes the selected service bases."
          },
          "503": {
            "description": "The Node setup runtime is unavailable"
          }
        },
        "tags": []
      }
    },
    "/setup/node/choice": {
      "post": {
        "operationId": "select_node_setup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Choice"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Choice is retained; this does not mean setup is complete"
          },
          "401": {
            "description": "Protected Node code missing or invalid"
          },
          "403": {
            "description": "Browser origin not allowed"
          },
          "409": {
            "description": "A different choice is already retained"
          },
          "503": {
            "description": "Protected retained state is unavailable"
          }
        },
        "security": [
          {
            "node_setup_code": []
          }
        ],
        "tags": []
      }
    },
    "/setup/node/create": {
      "post": {
        "operationId": "create_node_installation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Create accepted; check Node readiness"
          },
          "400": {
            "description": "Invalid administrator details"
          },
          "401": {
            "description": "Protected Node code missing or invalid"
          },
          "403": {
            "description": "Browser origin not allowed"
          },
          "409": {
            "description": "Create conflicts with retained setup"
          },
          "503": {
            "description": "Setup unavailable"
          }
        },
        "security": [
          {
            "node_setup_code": []
          }
        ],
        "tags": ["node_create"]
      }
    },
    "/setup/node/create/cancel": {
      "post": {
        "operationId": "cancel_node_create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Cancellation signaled; retained state is not rolled back"
          },
          "401": {
            "description": "Protected Node code missing or invalid"
          },
          "403": {
            "description": "Browser origin not allowed"
          },
          "409": {
            "description": "No matching incomplete Create operation"
          },
          "503": {
            "description": "Setup unavailable"
          }
        },
        "security": [
          {
            "node_setup_code": []
          }
        ],
        "tags": ["node_create"]
      }
    },
    "/setup/node/create/intent": {
      "post": {
        "operationId": "recover_node_create",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateRecovery"
                }
              }
            },
            "description": "Exact retained Create details, without credentials"
          },
          "204": {
            "description": "No Create operation is retained"
          },
          "401": {
            "description": "Protected Node code missing or invalid"
          },
          "403": {
            "description": "Browser origin not allowed"
          },
          "409": {
            "description": "Conflicting retained setup"
          },
          "503": {
            "description": "Setup unavailable"
          }
        },
        "security": [
          {
            "node_setup_code": []
          }
        ],
        "tags": ["node_create"]
      }
    }
  },
  "servers": [
    {
      "url": "https://unified.localhost:1355"
    }
  ]
}
