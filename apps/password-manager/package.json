{
    "name": "password-manager",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "portless password-manager vite dev",
        "build": "vite build",
        "preview": "portless password-manager vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "biome lint .",
        "lint:fix": "biome lint --write .",
        "format": "biome format .",
        "format:fix": "biome format --write .",
        "postinstall": "svelte-kit sync",
        "test": "vitest run"
    },
    "devDependencies": {
        "@aicacia/native-fetch": "workspace:*",
        "@biomejs/biome": "^2.5.3",
        "@inlang/paraglide-js": "^2.21.0",
        "@standard-schema/spec": "^1.1.0",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.69.2",
        "@sveltejs/vite-plugin-svelte": "^7.2.0",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.2",
        "@types/node": "^26.1.1",
        "globals": "^17.7.0",
        "jsdom": "~27.4.0",
        "portless": "^0.15.4",
        "svelte": "^5.56.4",
        "svelte-check": "^4.7.2",
        "tailwindcss": "^4.3.2",
        "typescript": "^5.9.3",
        "vite": "^8.1.4",
        "vite-plugin-devtools-json": "^1.0.0",
        "vitest": "4.1.10"
    },
    "dependencies": {
        "@aicacia/idp-client": "workspace:*",
        "@aicacia/management-client": "workspace:*",
        "@aicacia/storage-client": "workspace:*",
        "@aicacia/storage-db-collection": "workspace:*",
        "@aicacia/svelte-forms": "^0.1.1",
        "@aicacia/svelte-headless": "workspace:*",
        "@lucide/svelte": "^1.24.0",
        "@of/sdk": "workspace:*",
        "@tanstack/svelte-db": "0.5.12",
        "valibot": "^1.4.2"
    }
}
