{
  "components": {
    "schemas": {
      "Challenge": {
        "additionalProperties": false,
        "properties": {
          "challenge": {
            "type": "string"
          },
          "operation": {
            "$ref": "#/components/schemas/IndependentCreateIntent"
          },
          "recipient": {
            "type": "string"
          },
          "registration": {}
        },
        "required": [
          "operation",
          "recipient",
          "registration",
          "challenge"
        ],
        "type": "object"
      },
      "IndependentCreateIntent": {
        "additionalProperties": false,
        "properties": {
          "administrator": {
            "type": "string"
          },
          "idp": {
            "type": "string"
          },
          "issuer": {
            "type": "string"
          },
          "management": {
            "type": "string"
          },
          "node": {
            "type": "string"
          },
          "operation_nonce": {
            "type": "string"
          },
          "peer": {
            "type": [
              "string",
              "null"
            ]
          },
          "purpose": {
            "type": "string"
          },
          "storage": {
            "type": "string"
          }
        },
        "required": [
          "purpose",
          "operation_nonce",
          "administrator",
          "node",
          "idp",
          "management",
          "storage",
          "issuer"
        ],
        "type": "object"
      },
      "IndependentCreateRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/IndependentCreateIntent"
          },
          {
            "properties": {
              "password": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "type": "object"
          }
        ]
      },
      "IndependentOwnerPublic": {
        "additionalProperties": false,
        "properties": {
          "clients": {
            "items": {},
            "type": "array"
          },
          "facts": {},
          "operation": {
            "$ref": "#/components/schemas/IndependentCreateIntent"
          },
          "owner": {
            "type": "string"
          },
          "registered": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "operation",
          "owner",
          "clients",
          "facts",
          "registered"
        ],
        "type": "object"
      },
      "IndependentSetupStatus": {
        "properties": {
          "owners": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "ready": {
            "type": "boolean"
          },
          "stage": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        },
        "required": [
          "stage",
          "state",
          "ready",
          "owners"
        ],
        "type": "object"
      },
      "Registration": {
        "additionalProperties": false,
        "properties": {
          "challenge": {
            "type": "string"
          },
          "operation": {
            "$ref": "#/components/schemas/IndependentCreateIntent"
          },
          "recipient": {
            "type": "string"
          },
          "registration": {}
        },
        "required": [
          "operation",
          "recipient",
          "registration",
          "challenge"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "setup_code": {
        "description": "Setup <this owner's host-generated code>; never OAuth or another owner's code",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "contact": {
      "email": "juha7kukkonen@gmail.com",
      "name": "Juha Kukkonen"
    },
    "description": "Utoipa's axum bindings for seamless integration for the two",
    "license": {
      "identifier": "MIT OR Apache-2.0",
      "name": "MIT OR Apache-2.0"
    },
    "title": "Independent owner setup",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/setup/admission": {
      "post": {
        "operationId": "admission",
        "responses": {
          "204": {
            "description": "This owner code is currently admitted"
          },
          "401": {
            "description": "Code invalid or retired"
          },
          "503": {
            "description": "Admission unavailable"
          }
        },
        "security": [
          {
            "setup_code": []
          }
        ],
        "tags": [
          "default"
        ]
      }
    },
    "/setup/cancel": {
      "post": {
        "operationId": "cancel",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IndependentCreateIntent"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Cancellation signaled; not cleanup completion"
          },
          "401": {
            "description": "Code invalid or retired"
          },
          "409": {
            "description": "No matching active operation"
          },
          "503": {
            "description": "Admission unavailable"
          }
        },
        "security": [
          {
            "setup_code": []
          }
        ],
        "tags": [
          "default"
        ]
      }
    },
    "/setup/create": {
      "post": {
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IndependentCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Exact Create accepted; empty body, not completion"
          },
          "400": {
            "description": "Invalid tuple or password"
          },
          "401": {
            "description": "Code invalid or retired"
          },
          "409": {
            "description": "Conflicting retained operation"
          },
          "503": {
            "description": "Owner unavailable"
          }
        },
        "security": [
          {
            "setup_code": []
          }
        ],
        "tags": [
          "default"
        ]
      }
    },
    "/setup/independent/challenge": {
      "post": {
        "description": "Worker handoff over verified HTTPS. Requires an active exact Setup operation and operation-bound recipient challenge; discovery grants no authority. Never log capability or registration credentials.",
        "operationId": "challenge",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Challenge"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Exact handoff accepted"
          },
          "400": {
            "description": "Invalid registration"
          },
          "403": {
            "description": "Operation or challenge denied"
          },
          "409": {
            "description": "Owner not ready"
          },
          "503": {
            "description": "Owner unavailable"
          }
        },
        "security": [
          {}
        ],
        "tags": [
          "default"
        ]
      }
    },
    "/setup/independent/history": {
      "post": {
        "description": "Worker-only return channel: active exact admitted Join, matching approval and constant-time return nonce, and a 64-character capability are required. Not OAuth authority.",
        "operationId": "history",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "History capability accepted"
          },
          "403": {
            "description": "Operation or return nonce denied"
          },
          "409": {
            "description": "Return channel full"
          }
        },
        "security": [
          {}
        ],
        "tags": [
          "default"
        ]
      }
    },
    "/setup/independent/public": {
      "get": {
        "operationId": "owner_public",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndependentOwnerPublic"
                }
              }
            },
            "description": "Operation-bound public owner metadata, not setup authorization"
          },
          "409": {
            "description": "Public owner metadata not yet available"
          }
        },
        "tags": [
          "default"
        ]
      }
    },
    "/setup/independent/register": {
      "post": {
        "description": "Worker handoff over verified HTTPS. Requires an active exact Setup operation and operation-bound recipient challenge; discovery grants no authority. Never log capability or registration credentials.",
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Registration"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Exact handoff accepted"
          },
          "400": {
            "description": "Invalid registration"
          },
          "403": {
            "description": "Operation or challenge denied"
          },
          "409": {
            "description": "Owner not ready"
          },
          "503": {
            "description": "Owner unavailable"
          }
        },
        "security": [
          {}
        ],
        "tags": [
          "default"
        ]
      }
    },
    "/setup/intent": {
      "post": {
        "operationId": "recover",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndependentCreateIntent"
                }
              }
            },
            "description": "Exact retained nonsecret operation with authenticated issuer"
          },
          "204": {
            "description": "No bound operation; empty body"
          },
          "401": {
            "description": "Code invalid or retired"
          },
          "503": {
            "description": "Admission unavailable"
          }
        },
        "security": [
          {
            "setup_code": []
          }
        ],
        "tags": [
          "default"
        ]
      }
    },
    "/setup/join": {
      "post": {
        "operationId": "join",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IndependentCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Exact Join accepted after authenticated discovery; empty body"
          },
          "400": {
            "description": "Invalid tuple; Join forbids password and administrator"
          },
          "401": {
            "description": "Code invalid or retired"
          },
          "409": {
            "description": "Conflicting retained operation"
          },
          "502": {
            "description": "Pinned peer discovery failed"
          },
          "503": {
            "description": "Owner unavailable"
          }
        },
        "security": [
          {
            "setup_code": []
          }
        ],
        "tags": [
          "default"
        ]
      }
    },
    "/setup/status": {
      "get": {
        "operationId": "status",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndependentSetupStatus"
                }
              }
            },
            "description": "Owner-local state; no login Client or secret"
          },
          "503": {
            "description": "Admission unavailable (empty body), or current owner readiness failed (nonsecret status with ready:false)"
          }
        },
        "tags": [
          "default"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "https://localhost/"
    }
  ]
}
