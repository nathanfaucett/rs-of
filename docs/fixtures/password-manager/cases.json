[
  { "name": "all-five-types-and-fields", "patch": [], "expect": "accept", "counts": { "items": 5, "folders": 2 } },
  { "name": "minimal-login-no-password", "patch": [{ "op": "replace", "path": "/items", "value": [{ "type": 1, "name": "Minimal login", "login": {} }] }], "expect": "accept" },
  { "name": "minimal-note-card-identity", "patch": [{ "op": "replace", "path": "/items", "value": [{ "type": 2, "name": "Note", "secureNote": {} }, { "type": 3, "name": "Card", "card": {} }, { "type": 4, "name": "Identity", "identity": {} }] }], "expect": "accept" },
  { "name": "custom-file-envelope", "patch": [{ "op": "remove", "path": "/encrypted" }, { "op": "remove", "path": "/folders" }, { "op": "replace", "path": "/items", "value": [] }], "expect": "accept" },
  { "name": "inherited-rule-omitted", "patch": [{ "op": "remove", "path": "/items/0/login/uris/0/match" }], "expect": "accept", "assertion": "Export first URI match as null, not 0." },
  { "name": "explicit-rule-not-inherited", "patch": [{ "op": "replace", "path": "/items/0/login/uris/0/match", "value": 0 }], "expect": "accept", "assertion": "Export first URI match as 0, not null." },
  { "name": "unknown-uri-rule", "patch": [{ "op": "replace", "path": "/items/0/login/uris/0/match", "value": 6 }], "expect": "block", "path": "/items/0/login/uris/0/match" },
  { "name": "linked-field", "patch": [{ "op": "replace", "path": "/items/0/fields/0/type", "value": 3 }, { "op": "add", "path": "/items/0/fields/0/linkedId", "value": 100 }], "expect": "block", "path": "/items/0/fields/0" },
  { "name": "unknown-field-variant", "patch": [{ "op": "replace", "path": "/items/0/fields/0/type", "value": 99 }], "expect": "block", "path": "/items/0/fields/0/type" },
  { "name": "boolean-not-wire-string", "patch": [{ "op": "replace", "path": "/items/0/fields/2/value", "value": false }], "expect": "block", "path": "/items/0/fields/2/value" },
  { "name": "boolean-false-string", "patch": [{ "op": "replace", "path": "/items/0/fields/2/value", "value": "false" }], "expect": "accept", "assertion": "Checkbox is false; do not use string truthiness." },
  { "name": "missing-history-date", "patch": [{ "op": "remove", "path": "/items/0/passwordHistory/0/lastUsedDate" }], "expect": "block", "path": "/items/0/passwordHistory/0/lastUsedDate" },
  { "name": "invalid-item-date", "patch": [{ "op": "replace", "path": "/items/0/creationDate", "value": "2025-02-30T00:00:00Z" }], "expect": "block", "path": "/items/0/creationDate" },
  { "name": "unknown-item-type", "patch": [{ "op": "replace", "path": "/items/0/type", "value": 6 }], "expect": "block", "path": "/items/0/type" },
  { "name": "encrypted-envelope", "patch": [{ "op": "replace", "path": "/encrypted", "value": true }], "expect": "block", "path": "/encrypted" },
