{
  "components": {
    "schemas": {
      "ApprovedDeviceEndpoints": {
        "additionalProperties": false,
        "properties": {
          "endpointIds": {
            "description": "Canonical Iroh endpoint public keys, not Device record IDs.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": ["endpointIds"],
        "type": "object"
      },
      "Challenge": {
        "additionalProperties": false,
        "properties": {
          "challenge": {
            "type": "string"
          },
          "operation": {
            "$ref": "#/components/schemas/IndependentCreateIntent"
          },
          "recipient": {
            "type": "string"
          },
          "registration": {}
        },
        "required": ["operation", "recipient", "registration", "challenge"],
        "type": "object"
      },
      "Device": {
        "properties": {
          "address": {
            "type": "string"
          },
          "publicKey": {
            "description": "Canonical Iroh endpoint public key.",
            "type": "string"
          }
        },
        "required": ["publicKey", "address"],
        "type": "object"
      },
      "DeviceEndpointIdentity": {
        "properties": {
          "deviceId": {
            "description": "Device record ID, not an endpoint public key.",
            "type": "string"
          },
          "endpointId": {
            "description": "Canonical Iroh endpoint public key.",
            "type": "string"
          },
          "ownerSubject": {
            "description": "User subject in the legacy Device owner binding, not the authenticated request actor or the endpoint identity.",
            "type": "string"
          }
        },
        "required": ["deviceId", "ownerSubject", "endpointId"],
        "type": "object"
      },
      "DeviceEnrollment": {
        "properties": {
          "approvalCode": {
            "type": ["string", "null"]
          },
          "id": {
            "description": "Device record ID, not an endpoint public key.",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/DeviceState"
          }
        },
        "required": ["id", "state"],
        "type": "object"
      },
      "DeviceEnrollmentRequest": {
        "properties": {
          "address": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "publicKey": {
            "description": "Canonical Iroh endpoint public key.",
            "type": "string"
          }
        },
        "required": ["name", "publicKey", "address"],
        "type": "object"
      },
      "DeviceInfo": {
        "properties": {
          "address": {
            "type": "string"
          },
          "createdAt": {
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "description": "Device record ID, not an endpoint public key.",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "publicKey": {
            "description": "Canonical Iroh endpoint public key.",
            "type": "string"
          },
          "revokedAt": {
            "format": "int64",
            "type": ["integer", "null"]
          },
          "state": {
            "$ref": "#/components/schemas/DeviceState"
          },
          "updatedAt": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": ["id", "name", "publicKey", "address", "state", "createdAt", "updatedAt"],
        "type": "object"
      },
      "DevicePairingApprovalPayload": {
        "properties": {
          "payload": {
            "description": "Exact text to sign as UTF-8 with the new endpoint private key.",
            "type": "string"
          }
        },
        "required": ["payload"],
        "type": "object"
      },
      "DevicePairingApprovalRequest": {
        "properties": {
          "signature": {
            "description": "Ed25519 signature over the exact UTF-8 approval payload, made with the new endpoint private key and encoded as base64url without padding.",
            "type": "string"
          }
        },
        "required": ["signature"],
        "type": "object"
      },
      "DevicePairingRequest": {
        "properties": {
          "acceptingPublicKey": {
            "description": "Canonical Iroh endpoint public key of the approved accepting Device.",
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "publicKey": {
            "description": "Canonical Iroh endpoint public key of the new Device.",
            "type": "string"
          }
        },
        "required": ["name", "publicKey", "address", "acceptingPublicKey"],
        "type": "object"
      },
      "DeviceRestriction": {
        "additionalProperties": false,
        "properties": {
          "adminAllowed": {
            "type": "boolean"
          }
        },
        "required": ["adminAllowed"],
        "type": "object"
      },
      "DeviceSelfRevocationRequest": {
        "properties": {
          "publicKey": {
            "description": "Canonical Iroh endpoint public key of the Device to revoke.",
            "type": "string"
          },
          "signature": {
            "description": "Ed25519 signature over the UTF-8 self-revocation payload, made with the endpoint private key and encoded as base64url without padding.",
            "type": "string"
          }
        },
        "required": ["publicKey", "signature"],
        "type": "object"
      },
      "DeviceState": {
        "enum": ["pending", "approved", "revoked"],
        "type": "string"
      },
      "DeviceTransferRequest": {
        "additionalProperties": false,
        "properties": {
          "ownerSubject": {
            "description": "User subject to set in the legacy Device owner binding, not the authenticated request actor or the endpoint identity.",
            "type": "string"
          }
        },
        "required": ["ownerSubject"],
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "database": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        },
        "required": ["database"],
        "type": "object"
      },
      "HealthStatus": {
        "oneOf": [
          {
            "enum": ["healthy"],
            "type": "string"
          },
          {
            "properties": {
              "unhealthy": {
                "type": "string"
              }
            },
            "required": ["unhealthy"],
            "type": "object"
          }
        ]
      },
      "IndependentCreateIntent": {
        "additionalProperties": false,
        "properties": {
          "administrator": {
            "type": "string"
          },
          "device": {
            "type": "string"
          },
          "idp": {
            "type": "string"
          },
          "issuer": {
            "type": "string"
          },
          "node": {
            "type": "string"
          },
          "operation_nonce": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "storage": {
            "type": "string"
          }
        },
        "required": [
          "purpose",
          "operation_nonce",
          "administrator",
          "node",
          "idp",
          "device",
          "storage",
          "issuer"
        ],
        "type": "object"
      },
      "IndependentCreateRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/IndependentCreateIntent"
          },
          {
            "properties": {
              "password": {
                "type": ["string", "null"]
              }
            },
            "type": "object"
          }
        ]
      },
      "IndependentOwnerPublic": {
        "additionalProperties": false,
        "properties": {
          "clients": {
            "items": {},
            "type": "array"
          },
          "facts": {},
          "operation": {
            "$ref": "#/components/schemas/IndependentCreateIntent"
          },
          "owner": {
            "type": "string"
          },
          "registered": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": ["operation", "owner", "clients", "facts", "registered"],
        "type": "object"
      },
      "OwnerCopyCleanup": {
        "additionalProperties": false,
        "description": "Exact cleanup binding for a Device owner transfer; only an authenticated Storage service may acknowledge it.",
        "properties": {
          "cleanupId": {
            "type": "string"
          },
          "deviceId": {
            "description": "Device record ID, not an endpoint public key.",
            "type": "string"
          },
          "endpointId": {
            "description": "Canonical Iroh endpoint public key.",
            "type": "string"
          },
          "newOwnerSubject": {
            "description": "New User subject in the legacy Device owner binding, not the request actor or the endpoint identity.",
            "type": "string"
          },
          "oldOwnerSubject": {
            "description": "Previous User subject in the legacy Device owner binding, not the request actor or the endpoint identity.",
            "type": "string"
          }
        },
        "required": ["cleanupId", "deviceId", "endpointId", "oldOwnerSubject", "newOwnerSubject"],
        "type": "object"
      },
      "OwnerSetupStatus": {
        "properties": {
          "owners": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "ready": {
            "type": "boolean"
          },
          "stage": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        },
        "required": ["stage", "state", "ready", "owners"],
        "type": "object"
      },
      "Registration": {
        "additionalProperties": false,
        "properties": {
          "challenge": {
            "type": "string"
          },
          "operation": {
            "$ref": "#/components/schemas/IndependentCreateIntent"
          },
          "recipient": {
            "type": "string"
          },
          "registration": {}
        },
        "required": ["operation", "recipient", "registration", "challenge"],
        "type": "object"
      },
      "ReplicationAdmissionRequest": {
        "additionalProperties": false,
        "properties": {
          "applicationId": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "resourceId": {
            "type": "string"
          },
          "sourceEndpointId": {
            "description": "Canonical Iroh endpoint public key of the source Device.",
            "type": "string"
          },
          "targetEndpointId": {
            "description": "Canonical Iroh endpoint public key of the target Device.",
            "type": "string"
          }
        },
        "required": [
          "sourceEndpointId",
          "targetEndpointId",
          "applicationId",
          "kind",
          "resourceId",
          "operation"
        ],
        "type": "object"
      },
      "SelectedResource": {
        "properties": {
          "applicationId": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "ownerSubject": {
            "description": "User subject in the Resource namespace, matched to the legacy Device owner binding. It is not the request actor or the endpoint identity.",
            "type": "string"
          },
          "resourceId": {
            "type": "string"
          }
        },
        "required": ["ownerSubject", "applicationId", "kind", "resourceId"],
        "type": "object"
      },
      "SelectedResourcesResponse": {
        "description": "Current policy for a Device-approved endpoint whose legacy owner is an active IdP User.\nPending cleanup is service-only evidence, never replication approval or cacheable permission.",
        "properties": {
          "adminAllowed": {
            "type": "boolean"
          },
          "deviceId": {
            "description": "Device record ID, not an endpoint public key.",
            "type": "string"
          },
          "endpointId": {
            "description": "Canonical Iroh endpoint public key.",
            "type": "string"
          },
          "ownerSubject": {
            "description": "User subject in the legacy Device owner binding, not the authenticated request actor or the endpoint identity.",
            "type": "string"
          },
          "pendingCleanup": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/OwnerCopyCleanup"
              }
            ]
          },
          "resources": {
            "items": {
              "$ref": "#/components/schemas/SelectedResource"
            },
            "type": "array"
          }
        },
        "required": ["deviceId", "endpointId", "ownerSubject", "adminAllowed", "resources"],
        "type": "object"
      },
      "SelectionKind": {
        "enum": ["database", "filesystem"],
        "type": "string"
      },
      "SelectionRequest": {
        "additionalProperties": false,
        "properties": {
          "applicationId": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/SelectionKind"
          },
          "storageAccessToken": {
            "type": "string"
          }
        },
        "required": ["applicationId", "kind", "id", "storageAccessToken"],
        "type": "object"
      },
      "TrustedDevice": {
        "properties": {
          "address": {
            "type": "string"
          },
          "publicKey": {
            "description": "Canonical Iroh endpoint public key.",
            "type": "string"
          }
        },
        "required": ["publicKey", "address"],
        "type": "object"
      },
      "UpdateDeviceRequest": {
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": ["name"],
        "type": "object"
      },
      "VersionResponse": {
        "properties": {
          "build": {
            "format": "date-time",
            "type": "string"
          },
          "features": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": ["name", "version", "build"],
        "type": "object"
      }
    },
    "securitySchemes": {
      "authorization": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "setup_code": {
        "description": "Setup <this owner's host-generated code>; never OAuth or another owner's code",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "contact": {
      "name": "nathanfaucett@gmail.com"
    },
    "description": "Device API server for LIDP",
    "license": {
      "identifier": "MIT OR Apache-2.0",
      "name": "MIT OR Apache-2.0"
    },
    "title": "LIDP Device API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/device": {
      "get": {
        "operationId": "device",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Device"
                }
              }
            },
            "description": "Local endpoint public key and address; not a Device record ID or proof of approval"
          }
        }
      }
    },
    "/devices": {
      "get": {
        "operationId": "list_devices",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DeviceInfo"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Device records whose legacy owner matches the User subject in the Device-audience access token"
          }
        },
        "security": [
          {
            "authorization": []
          }
        ]
      }
    },
    "/devices/endpoints": {
      "get": {
        "operationId": "list_approved_device_endpoints",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovedDeviceEndpoints"
                }
              }
            },
            "description": "Iroh endpoint public keys of approved Devices"
          },
          "401": {
            "description": "Invalid client access token"
          },
          "403": {
            "description": "Client lacks device-list permission"
          }
        },
        "security": [
          {
            "authorization": []
          }
        ]
      }
    },
    "/devices/endpoints/{endpoint_id}": {
      "get": {
        "operationId": "lookup_device_endpoint",
        "parameters": [
          {
            "description": "Iroh endpoint public key",
            "in": "path",
            "name": "endpoint_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceEndpointIdentity"
                }
              }
            },
            "description": "Approved Device endpoint binding with an active legacy owner"
          },
          "401": {
            "description": "Invalid client access token"
          },
          "403": {
            "description": "Client lacks device lookup permission"
          },
          "404": {
            "description": "Endpoint is not an approved device"
          }
        },
        "security": [
          {
            "authorization": []
          }
        ]
      }
    },
    "/devices/enrollments": {
      "get": {
        "operationId": "list_pending_enrollments",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DeviceEnrollment"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Pending device enrollments"
          }
        },
        "security": [
          {
            "authorization": []
          }
        ]
      },
      "post": {
        "operationId": "enroll_device",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceEnrollmentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceEnrollment"
                }
              }
            },
            "description": "Device enrollment"
          }
        },
        "security": [
          {
            "authorization": []
          }
        ]
      }
    },
    "/devices/enrollments/{device_id}/approve": {
      "post": {
        "description": "Approve a legacy pending enrollment, not a pairing. Pairing approval requires proof of possession of the new endpoint key.",
        "operationId": "approve_enrollment",
        "parameters": [
          {
            "description": "Device record ID",
            "in": "path",
            "name": "device_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceEnrollment"
                }
              }
            },
            "description": "Approved enrollment"
          }
        },
        "security": [
          {
            "authorization": []
          }
        ]
      }
    },
    "/devices/identities/{device_id}": {
      "get": {
        "operationId": "lookup_device_identity",
        "parameters": [
          {
            "description": "Device record ID",
            "in": "path",
            "name": "device_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceEndpointIdentity"
                }
              }
            },
            "description": "Approved Device endpoint binding with an active legacy owner"
          }
        },
        "security": [
          {
            "authorization": []
          }
        ]
      }
    },
    "/devices/pairings": {
      "post": {
        "description": "An active User with the Installation permission management.devices.enroll creates a pending pairing. The Device-audience access token identifies the User. The accepting endpoint must already be approved.",
        "operationId": "request_pairing",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DevicePairingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceEnrollment"
                }
              }
            },
            "description": "Pending Device pairing"
          },
          "401": {
            "description": "User authentication required"
          },
          "403": {
            "description": "Enrollment not authorized"
          }
        },
        "security": [
          {
            "authorization": []
          }
        ]
      },
      "put": {
        "description": "Create or replay one pending pairing in this Installation. The new endpoint public key is the retry key. Only the original authenticated User, still authorized to enroll Devices, can replay it with the exact same accepting key, name and address. The accepting endpoint must still be approved. A legacy or terminal enrollment is not replayable.",
        "operationId": "request_pairing_once",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DevicePairingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceEnrollment"
                }
              }
            },
            "description": "New or exact existing pending Device pairing"
          },
          "400": {
            "description": "Input or retained enrollment does not match"
          },
          "401": {
            "description": "User authentication required"
          },
          "403": {
            "description": "Enrollment not authorized"
          },
          "503": {
            "description": "Device owner unavailable"
          }
        },
        "security": [
          {
            "authorization": []
          }
        ]
      }
    },
    "/devices/pairings/{device_id}/approve": {
      "post": {
        "description": "The Device-audience access token identifies the active User, who must have the Installation permission management.devices.enroll. Device checks that the accepting endpoint is still approved and its legacy owner binding matches the pairing, then verifies the new endpoint signature. Approval does not create a Selection or grant Resource access.",
        "operationId": "approve_pairing",
        "parameters": [
          {
            "description": "Device record ID",
            "in": "path",
            "name": "device_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DevicePairingApprovalRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceInfo"
                }
              }
            },
            "description": "Device approved after proof of possession of the new endpoint key"
          },
          "401": {
            "description": "User authentication required"
          },
          "403": {
            "description": "Proof or enrollment permission denied"
          }
        },
        "security": [
          {
            "authorization": []
          }
        ]
      }
    },
    "/devices/pairings/{device_id}/payload": {
      "get": {
        "description": "Use a Device-audience access token for an active User with the Installation permission management.devices.enroll. Give the exact payload to the new endpoint to sign.",
        "operationId": "pairing_approval_payload",
        "parameters": [
          {
            "description": "Device record ID",
            "in": "path",
            "name": "device_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DevicePairingApprovalPayload"
                }
              }
            },
            "description": "Exact payload to sign with the new Device key"
          },
          "401": {
            "description": "User authentication required"
          },
          "403": {
            "description": "Pairing not authorized or no longer pending"
          }
        },
        "security": [
          {
            "authorization": []
          }
        ]
      }
    },
    "/devices/revoke-self": {
      "post": {
        "description": "Revoke the Device identified by its endpoint public key. The signature proves possession of that key. No User token or Management permission is required.",
        "operationId": "revoke_self",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceSelfRevocationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Device revoked"
          }
        }
      }
    },
    "/devices/trusted": {
      "get": {
        "operationId": "trusted_devices",
        "responses": {
          "200": {
            "content": {
              "application/json": {
