{
    "name": "@aicacia/storage-db-collection",
    "version": "0.1.0",
    "type": "module",
    "main": "esm/index.js",
    "types": "types/index.d.ts",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "default": "./esm/index.js"
        }
    },
    "scripts": {
        "build": "tsc --project tsconfig.json",
        "check": "tsc --project tsconfig.json --noEmit --incremental false",
