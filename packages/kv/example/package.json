{
  "name": "@ofsdk/kv-browser-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Svelte + Tailwind browser example for @ofsdk/kv (KV over IndexedDB with sync)",
  "scripts": {
    "predev": "pnpm --filter @ofsdk/kv run build:wasm",
    "dev": "portless kv-example vite dev",
    "build": "vite build && node scripts/verify-wasm.js",
    "preview": "portless kv-example vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "test": "playwright test smoke.test.ts"
  },
  "dependencies": {
    "@ofsdk/kv": "file:.."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "portless": "^0.15.4",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.2.0"
  }
}
