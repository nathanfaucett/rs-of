pub async fn bounded_text(mut response: reqwest::Response, limit: usize) -> Result<String, serde_json::Error> {
    use serde::de::Error;
    if response.content_length().is_some_and(|length| length > limit as u64) {
        return Err(serde_json::Error::custom("response exceeds byte limit"));
    }
    let mut bytes = Vec::new();
    while let Some(chunk) = response.chunk().await.map_err(|_| serde_json::Error::custom("response read failed"))? {
        if chunk.len() > limit.saturating_sub(bytes.len()) {
            return Err(serde_json::Error::custom("response exceeds byte limit"));
        }
        bytes.extend_from_slice(&chunk);
    }
    String::from_utf8(bytes).map_err(|_| serde_json::Error::custom("response is not UTF-8"))
}

pub fn check_request(request: &reqwest::Request, limit: usize) -> Result<(), serde_json::Error> {
    use serde::de::Error;
    let mut size = request.headers().iter().fold(request.url().as_str().len(), |size, (name, value)| {
        size.saturating_add(name.as_str().len()).saturating_add(value.len())
    });
    if let Some(body) = request.body() {
        let bytes = body.as_bytes().ok_or_else(|| serde_json::Error::custom("request body is unbounded"))?;
        size = size.saturating_add(bytes.len());
    }
    if size > limit {
        return Err(serde_json::Error::custom("request exceeds byte limit"));
    }
    Ok(())
}
