    "/independent/node-joins/history/request": {
      "post": {
        "description": "Requires verified exact independent approval and current owner permission. Returns a capability only through the operation-bound recipient callback.",
        "operationId": "independent_join_request_history",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HistoryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Callback accepted"
          },
          "400": {
            "description": "Invalid recipient"
          },
          "403": {
            "description": "Approval denied"
          },
          "503": {
            "description": "Unavailable"
          }
        },
        "security": [
          {}
        ],
        "tags": [
          "independent_join"
        ]
      }
    },
    "/independent/node-joins/history/stream": {
      "get": {
