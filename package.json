{
  "name": "@ofsdk/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm -r run test",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:lifecycle": "node --test e2e/backend.test.mjs",
    "test:e2e:check": "pnpm --filter @ofsdk/app exec tsc --project ../../e2e/tsconfig.json",
    "test:backend": "pnpm --filter @ofsdk/app test && pnpm --filter @ofsdk/password-manager test:backend",
    "e2e:prepare": "pnpm sdk:build && pnpm --filter @ofsdk/native-fetch --filter @ofsdk/oidc-client run build:esm && pnpm --filter @ofsdk/svelte-headless exec svelte-kit sync && pnpm --filter @ofsdk/svelte-headless exec svelte-package && pnpm --filter @ofsdk/sync-sdk run build:browser && pnpm --filter @ofsdk/app --filter @ofsdk/password-manager exec svelte-kit sync",
    "coverage": "pnpm -r run coverage",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "format": "pnpm -r run format",
    "format:fix": "pnpm -r run format:fix",
    "apps:dev": "pnpm --filter \"./apps/*\" run dev",
    "apps:build": "pnpm --filter \"./apps/*\" run build",
    "apps:desktop": "pnpm --filter \"./apps/*\" run desktop",
    "sdk:build": "pnpm --filter @ofsdk/idp-client --filter @ofsdk/management-client --filter @ofsdk/device-client --filter @ofsdk/storage-client run build:esm && pnpm --filter @ofsdk/storage-sync-client run build",
    "packages:build": "pnpm --filter \"./packages/*\" --filter \"./crates/*\" run build",
    "openapi:idp": "pnpm --filter \"./packages/idp-client\" run openapi",
    "openapi:device": "node scripts/generate-openapi-client.mjs device",
    "openapi:management": "pnpm --filter \"./packages/management-client\" run openapi",
    "openapi": "node scripts/generate-openapi-client.mjs",
    "openapi:export": "cargo run -p unified-server --example export-openapi -- openapi",
    "openapi:check": "node scripts/qualify-openapi-clients.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@playwright/test": "^1.64.1",
    "@vitest/browser-playwright": "4.1.10",
    "vitest": "4.1.10",
    "portless": "^0.15.4"
  }
}
