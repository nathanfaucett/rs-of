      },
      "DatabaseResource": {
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "FileSystemDetailResponse": {
        "properties": {
          "applicationId": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "applicationId"
        ],
        "type": "object"
      },
      "FileSystemResourceResponse": {
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "HistoryRequest": {
        "additionalProperties": false,
        "properties": {
          "approval": {
            "$ref": "#/components/schemas/IndependentJoinApproval"
          },
          "recipient": {
            "type": "string"
          },
          "return_nonce": {
            "type": "string"
          }
        },
        "required": [
          "approval",
          "recipient",
          "return_nonce"
        ],
        "type": "object"
      },
      "IndependentCreateIntent": {
        "additionalProperties": false,
        "properties": {
          "administrator": {
            "type": "string"
          },
          "idp": {
            "type": "string"
          },
          "issuer": {
            "type": "string"
          },
          "management": {
            "type": "string"
          },
          "node": {
            "type": "string"
          },
          "operation_nonce": {
            "type": "string"
          },
          "peer": {
            "type": [
              "string",
              "null"
            ]
          },
          "purpose": {
            "type": "string"
          },
          "storage": {
            "type": "string"
          }
        },
        "required": [
          "purpose",
          "operation_nonce",
          "administrator",
          "node",
          "idp",
          "management",
          "storage",
          "issuer"
        ],
        "type": "object"
      },
      "IndependentCreateRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/IndependentCreateIntent"
          },
          {
            "properties": {
              "password": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "type": "object"
          }
        ]
      },
      "IndependentJoinApproval": {
        "additionalProperties": false,
        "properties": {
          "owner_subject": {
            "format": "uuid",
            "type": "string"
          },
          "request": {
            "$ref": "#/components/schemas/IndependentJoinRequest"
          },
          "signature": {
            "type": "string"
          }
        },
        "required": [
          "request",
          "owner_subject",
          "signature"
        ],
        "type": "object"
      },
      "IndependentJoinRequest": {
        "additionalProperties": false,
        "properties": {
          "device_id": {
            "format": "uuid",
            "type": "string"
          },
          "endpoint_id": {
            "type": "string"
          },
          "member_id": {
            "format": "uuid",
            "type": "string"
          },
          "operation": {
            "$ref": "#/components/schemas/IndependentCreateIntent"
          },
          "public_signer": {
            "$ref": "#/components/schemas/JwkPublic"
          },
          "source": {
            "$ref": "#/components/schemas/IndependentPeer"
          }
        },
        "required": [
          "operation",
          "device_id",
          "member_id",
          "endpoint_id",
          "public_signer",
          "source"
        ],
        "type": "object"
      },
      "IndependentOwnerPublic": {
        "additionalProperties": false,
        "properties": {
          "clients": {
            "items": {},
            "type": "array"
          },
          "facts": {},
          "operation": {
            "$ref": "#/components/schemas/IndependentCreateIntent"
          },
          "owner": {
            "type": "string"
          },
          "registered": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "operation",
          "owner",
          "clients",
          "facts",
          "registered"
        ],
        "type": "object"
      },
      "IndependentPeer": {
        "additionalProperties": false,
        "properties": {
          "address": {},
          "endpoint": {
            "type": "string"
          },
          "idp": {
            "type": "string"
          },
          "issuer": {
            "type": "string"
          },
          "management": {
            "type": "string"
          },
          "nonce": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          }
        },
        "required": [
          "nonce",
          "issuer",
          "idp",
          "management",
          "endpoint",
          "address",
          "signature"
        ],
        "type": "object"
      },
      "IndependentSetupStatus": {
        "properties": {
          "owners": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "ready": {
            "type": "boolean"
          },
          "stage": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        },
        "required": [
          "stage",
          "state",
          "ready",
          "owners"
        ],
        "type": "object"
      },
      "JwkPublic": {
        "allOf": [
          {
            "$ref": "#/components/schemas/JwkPublicParameters"
          },
          {
            "properties": {
              "alg": {
                "$ref": "#/components/schemas/JwsAlgorithm",
                "description": "Algorithm intended for use"
              },
              "kid": {
                "description": "Key ID",
                "type": "string"
              },
              "use": {
                "$ref": "#/components/schemas/KeyUse",
                "description": "Key use (sig, enc)"
              }
            },
            "required": [
              "use",
              "kid",
              "alg"
            ],
            "type": "object"
          }
        ]
      },
      "JwkPublicParameters": {
        "oneOf": [
          {
            "properties": {
              "e": {
                "type": "string"
              },
              "kty": {
                "enum": [
                  "Rsa"
                ],
                "type": "string"
              },
              "n": {
                "type": "string"
              }
            },
            "required": [
              "n",
              "e",
              "kty"
            ],
            "type": "object"
          },
          {
            "properties": {
              "crv": {
                "type": "string"
              },
              "kty": {
                "enum": [
                  "Ec"
                ],
                "type": "string"
              },
              "x": {
                "type": "string"
              },
              "y": {
                "type": "string"
              }
            },
            "required": [
              "crv",
              "x",
              "y",
              "kty"
            ],
            "type": "object"
          },
          {
            "properties": {
              "crv": {
                "type": "string"
              },
              "kty": {
                "enum": [
                  "Opk"
                ],
                "type": "string"
              },
              "x": {
                "type": "string"
              }
            },
            "required": [
              "crv",
              "x",
              "kty"
            ],
            "type": "object"
          }
        ]
      },
      "JwsAlgorithm": {
        "enum": [
          "RS256",
          "RS384",
          "RS512",
          "ES256",
          "ES256K",
          "ES384",
          "ES512",
          "PS256",
          "PS384",
          "PS512",
          "EdDSA"
        ],
        "type": "string"
      },
      "KeyUse": {
        "enum": [
          "sig",
          "enc"
        ],
        "type": "string"
      },
      "Registration": {
        "additionalProperties": false,
        "properties": {
          "challenge": {
            "type": "string"
          },
          "operation": {
            "$ref": "#/components/schemas/IndependentCreateIntent"
          },
          "recipient": {
            "type": "string"
          },
          "registration": {}
        },
        "required": [
          "operation",
          "recipient",
          "registration",
          "challenge"
        ],
        "type": "object"
      },
      "ResidencyMode": {
        "enum": [
          "full",
          "passthrough"
        ],
        "type": "string"
      },
      "ResourceResidency": {
        "additionalProperties": false,
        "properties": {
          "mode": {
            "$ref": "#/components/schemas/ResidencyMode"
          }
        },
        "required": [
          "mode"
        ],
        "type": "object"
      },
      "SetupStatus": {
        "properties": {
          "owners": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "ready": {
            "type": "boolean"
          },
          "stage": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        },
        "required": [
          "stage",
          "state",
          "ready",
          "owners"
        ],
        "type": "object"
      },
      "VersionResponse": {
        "properties": {
          "build": {
            "format": "date-time",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "build"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "authorization": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "setup_code": {
        "description": "Setup <this owner's host-generated code>; never OAuth or another owner's code",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "contact": {
      "name": "nathanfaucett@gmail.com"
    },
    "description": "Local first storage server",
    "license": {
      "identifier": "MIT OR Apache-2.0",
