    "/filesystems/{filesystem_id}": {
      "delete": {
        "operationId": "delete_file_system",
        "parameters": [
          {
            "description": "Filesystem resource ID",
            "in": "path",
            "name": "filesystem_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Filesystem resource tombstoned"
          },
          "401": {
            "description": "Invalid storage authorization"
          },
          "403": {
            "description": "Token does not permit writes"
          },
          "404": {
            "description": "Filesystem resource not found"
          },
          "503": {
            "description": "Storage runtime or IdP unavailable"
          }
        },
        "security": [
          {
            "authorization": []
          }
        ],
        "tags": ["resources"]
      },
      "get": {
        "operationId": "get_file_system",
        "parameters": [
          {
            "description": "Filesystem resource ID",
            "in": "path",
            "name": "filesystem_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileSystemDetailResponse"
                }
              }
            },
            "description": "Filesystem resource"
          },
          "401": {
            "description": "Invalid storage authorization"
          },
          "403": {
            "description": "Token does not permit reads"
          },
          "404": {
            "description": "Filesystem resource not found"
