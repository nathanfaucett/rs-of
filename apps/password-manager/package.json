{
  "name": "@ofsdk/password-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "portless run --name password-manager vite dev",
    "dev:seeded": "portless run --name password-manager vite dev --mode seeded",
    "dev:logs": "portless run --name password-manager vite dev 2>&1 | tee .vite-dev.log",
    "build": "vite build",
    "preview": "portless password-manager vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "postinstall": "svelte-kit sync",
    "test": "vitest run",
    "test:backend": "vitest run --config vitest.e2e.config.ts",
    "test:e2e": "playwright test --config ../../e2e/playwright.config.ts --project password-manager",
    "test:offline": "vite build && node scripts/check-offline.mjs && node scripts/check-json-export.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",

    "@ofsdk/native-fetch": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@standard-schema/spec": "^1.1.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.69.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.1",
    "@vitest/browser-playwright": "4.1.10",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.7.0",
    "jsdom": "~27.4.0",
    "playwright": "^1.64.1",
    "portless": "^0.15.4",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.2",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "vite-plugin-devtools-json": "^1.0.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@aicacia/svelte-forms": "^0.1.1",
    "@lucide/svelte": "^1.24.0",
    "@ofsdk/idp-client": "workspace:*",
    "@ofsdk/management-client": "workspace:*",
    "@ofsdk/oidc-client": "workspace:*",
    "@ofsdk/sql": "workspace:*",
    "@ofsdk/storage-sync-client": "workspace:*",
    "@ofsdk/svelte-headless": "workspace:*",
    "@ofsdk/sync-sdk": "workspace:*",
    "@tanstack/db": "~0.15.2",
    "@tanstack/svelte-db": "0.5.12",
    "jose": "5.9.6",
    "valibot": "^1.4.2"
  }
}
