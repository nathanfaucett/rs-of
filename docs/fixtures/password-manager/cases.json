  { "name": "trash-not-revived", "patch": [{ "op": "replace", "path": "/items/0/deletedDate", "value": "2025-04-01T00:00:00Z" }], "expect": "block", "path": "/items/0/deletedDate" },
  { "name": "archive-not-revived", "patch": [{ "op": "replace", "path": "/items/0/archivedDate", "value": "2025-04-01T00:00:00Z" }], "expect": "block", "path": "/items/0/archivedDate" },
  { "name": "unknown-item-key", "patch": [{ "op": "add", "path": "/items/0/futureData", "value": "SYNTHETIC" }], "expect": "block", "path": "/items/0/futureData" },
