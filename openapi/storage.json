{
  "components": {
    "schemas": {
      "Challenge": {
        "additionalProperties": false,
        "properties": {
          "challenge": {
            "type": "string"
          },
          "operation": {
            "$ref": "#/components/schemas/IndependentCreateIntent"
          },
          "recipient": {
            "type": "string"
          },
          "registration": {}
        },
        "required": ["operation", "recipient", "registration", "challenge"],
        "type": "object"
      },
      "CreateResourceRequest": {
        "properties": {
          "name": {
            "type": ["string", "null"]
          }
        },
        "type": "object"
      },
      "DatabaseDetailResponse": {
        "properties": {
          "applicationId": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": ["string", "null"]
          }
        },
        "required": ["id", "applicationId"],
        "type": "object"
      },
      "DatabaseFailure": {
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "required": ["code"],
        "type": "object"
      },
      "DatabaseResource": {
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": ["string", "null"]
          }
        },
        "required": ["id"],
        "type": "object"
      },
      "EnsureDatabaseRequest": {
        "additionalProperties": false,
        "properties": {
          "creationKey": {
            "description": "Case-sensitive application-chosen identity; 1–128 UTF-8 bytes.",
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "type": ["string", "null"]
          }
        },
        "required": ["creationKey"],
        "type": "object"
      },
      "FileSystemDetailResponse": {
        "properties": {
          "applicationId": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": ["string", "null"]
          }
        },
        "required": ["id", "applicationId"],
        "type": "object"
      },
      "FileSystemResourceResponse": {
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": ["string", "null"]
          }
        },
        "required": ["id"],
        "type": "object"
      },
      "IndependentCreateIntent": {
        "additionalProperties": false,
        "properties": {
          "administrator": {
            "type": "string"
          },
          "device": {
            "type": "string"
          },
          "idp": {
            "type": "string"
          },
          "issuer": {
            "type": "string"
          },
          "node": {
            "type": "string"
          },
          "operation_nonce": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "storage": {
            "type": "string"
          }
        },
        "required": [
          "purpose",
          "operation_nonce",
          "administrator",
          "node",
          "idp",
          "device",
          "storage",
          "issuer"
        ],
        "type": "object"
      },
      "IndependentCreateRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/IndependentCreateIntent"
          },
          {
            "properties": {
              "password": {
                "type": ["string", "null"]
              }
            },
            "type": "object"
          }
        ]
      },
      "IndependentOwnerPublic": {
        "additionalProperties": false,
        "properties": {
          "clients": {
            "items": {},
            "type": "array"
          },
          "facts": {},
          "operation": {
            "$ref": "#/components/schemas/IndependentCreateIntent"
          },
          "owner": {
            "type": "string"
          },
          "registered": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": ["operation", "owner", "clients", "facts", "registered"],
        "type": "object"
      },
      "OwnerSetupStatus": {
        "properties": {
          "owners": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "ready": {
            "type": "boolean"
          },
          "stage": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        },
        "required": ["stage", "state", "ready", "owners"],
        "type": "object"
      },
      "Registration": {
        "additionalProperties": false,
        "properties": {
          "challenge": {
            "type": "string"
          },
          "operation": {
            "$ref": "#/components/schemas/IndependentCreateIntent"
          },
          "recipient": {
            "type": "string"
          },
          "registration": {}
        },
        "required": ["operation", "recipient", "registration", "challenge"],
        "type": "object"
      },
      "ResidencyMode": {
        "enum": ["full", "passthrough"],
        "type": "string"
      },
      "ResourceResidency": {
        "additionalProperties": false,
        "properties": {
          "mode": {
            "$ref": "#/components/schemas/ResidencyMode"
          }
        },
        "required": ["mode"],
        "type": "object"
      },
      "SqlRequest": {
        "additionalProperties": false,
        "properties": {
          "statements": {
            "items": {
              "$ref": "#/components/schemas/SqlStatement"
            },
            "maxItems": 32,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": ["statements"],
        "type": "object"
      },
      "SqlResponse": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/SqlResult"
            },
            "type": "array"
          }
        },
        "required": ["results"],
        "type": "object"
      },
      "SqlResult": {
        "properties": {
          "columns": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "rows": {
            "items": {
              "items": {
                "$ref": "#/components/schemas/SqlValue"
              },
              "type": "array"
            },
            "type": "array"
          }
        },
        "required": ["columns", "rows"],
        "type": "object"
      },
      "SqlStatement": {
        "additionalProperties": false,
        "properties": {
          "params": {
            "items": {
              "$ref": "#/components/schemas/SqlValue"
            },
            "maxItems": 128,
            "type": "array"
          },
          "sql": {
            "description": "SQL text, at most 16 KiB UTF-8; positional parameters only.",
            "type": "string"
          }
        },
        "required": ["sql"],
        "type": "object"
      },
      "SqlValue": {
        "oneOf": [
          {
            "properties": {
              "type": {
                "enum": ["null"],
                "type": "string"
              }
            },
            "required": ["type"],
            "type": "object"
          },
          {
            "properties": {
              "type": {
                "enum": ["boolean"],
                "type": "string"
              },
              "value": {
                "type": "boolean"
              }
            },
            "required": ["value", "type"],
            "type": "object"
          },
          {
            "properties": {
              "type": {
                "enum": ["integer"],
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": ["value", "type"],
            "type": "object"
          },
          {
            "properties": {
              "type": {
                "enum": ["float"],
                "type": "string"
              },
              "value": {
                "format": "double",
                "type": "number"
              }
            },
            "required": ["value", "type"],
            "type": "object"
          },
          {
            "properties": {
              "type": {
                "enum": ["text"],
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": ["value", "type"],
            "type": "object"
          },
          {
            "properties": {
              "type": {
                "enum": ["uuid"],
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": ["value", "type"],
            "type": "object"
          },
          {
            "properties": {
              "type": {
                "enum": ["blob"],
                "type": "string"
              },
              "value": {
                "items": {
                  "format": "int32",
                  "minimum": 0,
                  "type": "integer"
                },
                "type": "array"
              }
            },
            "required": ["value", "type"],
            "type": "object"
          }
        ]
      },
      "VersionResponse": {
        "properties": {
          "build": {
            "format": "date-time",
            "type": "string"
          },
          "features": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": ["name", "version", "build"],
        "type": "object"
      }
    },
    "securitySchemes": {
      "authorization": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "setup_code": {
        "description": "Setup <this owner's host-generated code>; never OAuth or another owner's code",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "contact": {
      "name": "nathanfaucett@gmail.com"
    },
    "description": "Local first storage server",
    "license": {
      "identifier": "MIT OR Apache-2.0",
      "name": "MIT OR Apache-2.0"
    },
    "title": "Storage Server",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "description": "HTTP WebSocket upgrade only; generated HTTP clients do not implement subsequent Storage messages. User token and filesystem resource authorization are checked before upgrade.",
        "operationId": "upgrade_socket",
        "parameters": [
          {
            "description": "websocket",
            "in": "header",
            "name": "Upgrade",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Upgrade",
            "in": "header",
            "name": "Connection",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Sec-WebSocket-Key",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "13",
            "in": "header",
            "name": "Sec-WebSocket-Version",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "User access token",
            "in": "query",
            "name": "access_token",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Filesystem resource ID",
            "in": "query",
            "name": "filesystem_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "101": {
            "description": "WebSocket connection upgraded"
          },
          "401": {
            "description": "Invalid storage authorization"
          },
          "503": {
            "description": "IdP validation service unavailable"
          }
        },
        "tags": []
      }
    },
    "/databases": {
      "get": {
        "operationId": "list_databases",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DatabaseResource"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Namespace database resources"
          },
          "401": {
            "description": "Invalid storage authorization"
          },
          "403": {
            "description": "Token does not permit reads"
          },
          "503": {
            "description": "Storage runtime or IdP unavailable"
          }
        },
        "security": [
          {
            "authorization": []
          }
        ],
        "tags": ["resources"]
      },
      "post": {
        "operationId": "create_database",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateResourceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseResource"
                }
              }
            },
            "description": "Database resource created"
          },
          "401": {
            "description": "Invalid storage authorization"
          },
          "403": {
            "description": "Token does not permit writes"
          },
          "503": {
            "description": "Storage runtime or IdP unavailable"
          }
        },
        "security": [
          {
            "authorization": []
          }
        ],
        "tags": ["resources"]
      }
    },
    "/databases/by-creation-key": {
      "get": {
        "operationId": "get_database_by_creation_key",
        "parameters": [
          {
            "description": "Exact database creation key in the signed-in namespace",
            "in": "query",
            "name": "creation_key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseResource"
                }
              }
            },
            "description": "Existing keyed database Resource"
          },
          "400": {
            "description": "Invalid creation key"
          },
          "401": {
            "description": "Invalid storage authorization"
          },
          "403": {
            "description": "Token does not permit reads"
          },
          "404": {
            "description": "No live keyed database Resource"
          },
          "503": {
            "description": "Storage runtime or authority unavailable"
          }
        },
        "security": [
          {
            "authorization": []
          }
        ],
        "tags": ["resources"]
      }
    },
    "/databases/ensure": {
      "post": {
        "operationId": "ensure_database",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnsureDatabaseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseResource"
                }
              }
            },
            "description": "Created or reopened explicit logical database"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseFailure"
                }
              }
            },
            "description": "Invalid creation key"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseFailure"
                }
              }
            },
            "description": "Invalid authorization"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseFailure"
                }
              }
            },
            "description": "Write denied"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseFailure"
                }
              }
            },
            "description": "Local copy fenced"
          },
          "410": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseFailure"
                }
              }
            },
            "description": "Identity tombstoned"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseFailure"
                }
              }
            },
            "description": "Request exceeds 256 KiB"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseFailure"
                }
              }
            },
            "description": "Malformed request"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseFailure"
                }
              }
            },
            "description": "Content unavailable"
          }
        },
        "security": [
          {
            "authorization": []
          }
        ],
        "tags": ["resources"]
      }
    },
    "/databases/{database_id}": {
      "delete": {
        "operationId": "delete_database",
        "parameters": [
          {
            "description": "Database resource ID",
            "in": "path",
            "name": "database_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Database resource tombstoned"
          },
          "401": {
            "description": "Invalid storage authorization"
          },
          "403": {
            "description": "Token does not permit writes"
          },
          "404": {
            "description": "Database resource not found"
          },
          "503": {
            "description": "Storage runtime or IdP unavailable"
          }
        },
        "security": [
          {
            "authorization": []
          }
        ],
        "tags": ["resources"]
      },
      "get": {
        "operationId": "get_database",
        "parameters": [
          {
            "description": "Database resource ID",
            "in": "path",
            "name": "database_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseDetailResponse"
                }
              }
            },
            "description": "Database resource"
          },
          "401": {
            "description": "Invalid storage authorization"
          },
          "403": {
            "description": "Token does not permit reads"
          },
          "404": {
            "description": "Database resource not found"
          },
          "503": {
            "description": "Storage runtime or IdP unavailable"
          }
        },
        "security": [
          {
            "authorization": []
          }
        ],
        "tags": ["resources"]
      }
    },
    "/databases/{database_id}/sql": {
      "post": {
        "operationId": "execute_sql",
        "parameters": [
          {
            "description": "Database resource ID",
            "in": "path",
            "name": "database_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SqlRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SqlResponse"
                }
              }
            },
            "description": "Complete atomic SQL batch"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseFailure"
                }
              }
            },
            "description": "Invalid SQL, parameters or execution failure"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseFailure"
                }
              }
            },
            "description": "Invalid database authorization"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseFailure"
                }
              }
            },
            "description": "Parsed actions denied"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseFailure"
                }
              }
            },
            "description": "Resource absent or deleted"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseFailure"
                }
              }
            },
            "description": "Local copy fenced"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseFailure"
                }
              }
            },
            "description": "Request or result limit exceeded"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseFailure"
                }
              }
            },
            "description": "Content or authorization unavailable"
          }
        },
        "security": [
          {
            "authorization": []
          }
        ],
        "tags": ["resources::sql"]
      }
    },
